{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"files": {
		"includes": [
			"!**/.pnpm-store",
			"!**/.turbo",
			"!**/cjs",
			"!**/coverage",
			"!**/esm",
			"!**/node_modules",
			"!**/CHANGELOG.md",
			"!skills-lock.json",
			"!pnpm-lock.yaml"
		]
	},
	"linter": {
		"rules": {
			"style": {
				"useNodejsImportProtocol": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "none"
		}
	}
}
