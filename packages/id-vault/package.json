{
	"name": "id-vault",
	"version": "1.0.0",
	"description": "ID generation and validation library",
	"keywords": [
		"security",
		"cryptography",
		"id generation"
	],
	"homepage": "https://github.com/cyberuni/id-vault",
	"bugs": {
		"url": "https://github.com/cyberuni/id-vault/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/id-vault.git",
		"directory": "packages/id-vault"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"default": "./esm/index.js"
			},
			"require": {
				"types": "./cjs/index.d.ts",
				"default": "./cjs/index.js"
			},
			"default": "./esm/index.js"
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"types": "./cjs/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.{spec,unit,test,accept,integrate,system,perf,stress}.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf cjs esm coverage --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"dependencies": {
		"crypto-js": "^4.2.0"
	},
	"devDependencies": {
		"@types/crypto-js": "^4.2.2",
		"@types/node": "^24.12.2",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.2.1",
		"depcheck": "^1.4.7",
		"jsdom": "^28.0.0",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 18"
	}
}
