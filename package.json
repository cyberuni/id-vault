{
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"format": "biome format . --write",
		"id": "pnpm --filter=./packages/id-vault",
		"lint": "biome lint .",
		"nuke": "turbo run nuke && pnpm nuke:root",
		"nuke:root": "rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "run-p lint verify:repos",
		"verify:repos": "turbo run build typecheck coverage depcheck",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"turbo": "^2.10.3"
	},
	"packageManager": "pnpm@11.1.3"
}
